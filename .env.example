# Copy to .env and export these in your hosting environment (the app reads process.env only).
PORT=3000
# Directory for the SQLite database and the encrypted medical-document vault
DATA_DIR=./data
# 32 random bytes, base64. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a key file is created at DATA_DIR/.master.key (fine for development, not for production).
CAMPSPACE_MASTER_KEY=
# 1 = show demo-account hints on the login page and allow the seed data. Set to 0 in production.
DEMO_MODE=1
# 1 = mark session cookies Secure (required behind HTTPS) and send HSTS
COOKIE_SECURE=0
# 1 = trust X-Forwarded-For / X-Forwarded-Proto from your reverse proxy
TRUST_PROXY=0
